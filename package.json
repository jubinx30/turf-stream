{
  "name": "turf-live-workspace",
  "version": "1.0.0",
  "description": "Turf Live - Camera-Agnostic Streaming Platform with 2-Hour Monetization Paywall",
  "scripts": {
    "start": "node backend/src/server.js",
    "test": "node backend/tests/api.test.js",
    "build": "npm run build --prefix frontend",
    "start:mediamtx": ".\\mediamtx\\mediamtx.exe .\\mediamtx\\mediamtx.yml",
    "simulate:camera": "node scripts/simulate-camera.js --turf turf1",
    "simulate:turf2": "node scripts/simulate-camera.js --turf turf2",
    "stop": "powershell -ExecutionPolicy Bypass -File .\\stop-all.ps1",
    "dev:backend": "node backend/src/server.js",
    "dev:frontend": "npm run dev --prefix frontend"
  }
}
